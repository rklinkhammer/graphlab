  "readOnly": true,
  "runtimeQualified": false,
  "tools": {
    "c++": "/usr/bin/c++",
    "cmake": null,
    "docker": "/usr/bin/docker",
    "ip": "/usr/sbin/ip",
    "ninja": null,
    "ovs-vsctl": "/usr/bin/ovs-vsctl",
    "qemu-system-aarch64": "/usr/bin/qemu-system-aarch64",
    "qemu-system-x86_64": null,
    "tc": "/usr/sbin/tc"
  },
  "version": "0.1.0"
}
