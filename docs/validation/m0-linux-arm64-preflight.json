{
  "apiVersion": "graphlab.preflight/v1",
  "build": {
    "compiler": "GNU-13.3.0",
    "cppStandard": 202100,
    "expectedFeature": 202211,
    "openssl": "OpenSSL 3.0.13 30 Jan 2024"
  },
  "host": {
    "architecture": "aarch64",
    "kernel": "6.8.0-134-generic",
    "os": "Linux"
  },
  "kvmDevicePresent": true,
  "kvmReadWriteAccess": false,
  "linuxHost": true,
